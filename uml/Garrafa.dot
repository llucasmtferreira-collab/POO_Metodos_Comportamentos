digraph UML {
    graph [bgcolor="white", margin=0.2];
    node [shape=plain, fontname="Arial"];

    Garrafa [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD><B>Garrafa</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">+ cor: String<BR ALIGN="LEFT"/>+ material: String<BR ALIGN="LEFT"/>+ capacidadeEmMl: int<BR ALIGN="LEFT"/>+ nivelAtualMl: int</TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">+ encher(quantidade: int): void<BR ALIGN="LEFT"/>+ beber(quantidade: int): void</TD></TR>
      </TABLE>
    >];
}
